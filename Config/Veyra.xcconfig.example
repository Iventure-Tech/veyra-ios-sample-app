// Veyra sample app configuration — copy this file to Veyra.xcconfig (same folder) and
// fill in the values issued to you during Veyra onboarding, then re-run xcodegen.
// Veyra.xcconfig is git-ignored; never commit it: a client secret in a tracked file must be
// treated as compromised.

// Your Apple Developer Team ID (also used as the App Attest team id).
DEVELOPMENT_TEAM = YOURTEAMID

// Identifiers assigned to your app at onboarding.
VEYRA_PAYMENT_APP_PROVIDER_ID = your-payment-app-provider-id
VEYRA_TOKEN_REQUESTOR_ID = your-token-requestor-id

// ── The values for the provider both SDKs use ───────────────────────────────────
// There is no mode to set: the SDK works out how to reach Veyra from the provider the app passes.
// Which one the sample builds is chosen in code, in AppProvider.provider(). It ships with the
// deprecated client-secret provider so the sample runs with just the client id and secret from
// your onboarding pack — FOR TESTING ONLY. Each provider reads only its own values:
//   assertion provider      VEYRA_CLIENT_ID + VEYRA_BANK_BACKEND_BASE_URL + VEYRA_BANK_CLIENT_ID /
//                           VEYRA_BANK_CLIENT_SECRET (RFC 8693 token exchange at
//                           {VEYRA_BANK_BACKEND_BASE_URL}/oauth2/token)
//   proxy provider          VEYRA_BANK_BACKEND_BASE_URL (your API gateway serves POST /issuertokengateway/v1/proxy)
//   client-secret provider  DEPRECATED — VEYRA_CLIENT_ID + VEYRA_CLIENT_SECRET held in the app

// OAuth client issued by Veyra. Client id: the assertion and client-secret providers.
// Client secret: the client-secret provider only.
VEYRA_CLIENT_ID = your-client-id
VEYRA_CLIENT_SECRET = your-client-secret

// Your bank backend (the assertion and proxy providers). xcconfig treats "//" as the start of
// a comment, so write the scheme separator as /$()/ — e.g. https:/$()/bank-backend.example
VEYRA_BANK_BACKEND_BASE_URL =

// Your bank's own OAuth client at its authorization server — NOT the Veyra client above, and
// never passed to the SDK. The assertion provider authenticates the token exchange with it
// (HTTP Basic).
VEYRA_BANK_CLIENT_ID = your-bank-client-id
VEYRA_BANK_CLIENT_SECRET = your-bank-client-secret

// PLACEHOLDER for your bank app's own logged-in session: the assertion provider's subject_token,
// and "Authorization: Bearer <token>" to the proxy provider's relay; blank means nobody is signed in. A real app uses its own
// login session here. This is not a Veyra credential.
VEYRA_BANK_SESSION_TOKEN = sample-bank-session
